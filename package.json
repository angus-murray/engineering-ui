{
  "name": "engineering-ui",
  "version": "1.4.0",
  "description": "Shared look and feel for the engineering apps: Tailwind theme, form controls, header, pop-ups and results components.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./theme.css"
  },
  "files": ["dist", "theme.css", "STYLE.md"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "typescript": "~5.8.2"
  }
}
